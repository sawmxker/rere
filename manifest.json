{
  "manifest_version": 3,
  "name": "reré: Quick ReSearching",
  "version": "0.2.49",
  "description": "Adds convenient search buttons to IMDb, MyAnimeList, and Goodreads, with profiles, per-site settings, and context menu.",

  "permissions": ["tabs", "storage", "activeTab", "contextMenus"],
  "host_permissions": ["*://www.imdb.com/*", "*://myanimelist.net/*", "*://www.goodreads.com/*", "*://api.jikan.moe/*", "*://v3.sg.media-imdb.com/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "rere-imdb-search@hiki.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },

  "background": {
    "scripts": ["storage.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://www.imdb.com/title/*"],
      "js": ["storage.js", "shared/content-utils.js", "content.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["*://myanimelist.net/anime/*", "*://myanimelist.net/manga/*"],
      "js": ["storage.js", "shared/content-utils.js", "mal-content.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["*://www.goodreads.com/book/show/*"],
      "js": ["storage.js", "shared/content-utils.js", "gr-content.js"],
      "css": ["styles.css"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}